{$HOST_URL} {
	# Compress the pages, scripts and API responses on the way out.
	encode zstd gzip

	# The app sets its own security headers (apps/server/cloud/lib/webApp.js);
	# Caddy only stops advertising itself.
	header -Server

	# One upstream for the whole site: the app serves the pages at / and the
	# API under /api itself, so nothing is rewritten here.
	reverse_proxy app:8080
}
