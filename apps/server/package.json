{
  "name": "docustamp-server",
  "version": "2.37.0",
  "description": "DocuStamp server (Parse Server + Express)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ophydami/docustamp"
  },
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "coverage": "TESTING=true nyc jasmine",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --cache --fix .",
    "prettier": "prettier --write '{cloud,spec}/{**/*,*}.js' 'index.js'",
    "start": "node index.js",
    "test": "TESTING=true jasmine",
    "test:runner": "MONGODB_TEST_URI=\"$(npx mongodb-runner start --id=docustamp-test | tail -1)\" TESTING=true jasmine",
    "test:runner:stop": "npx mongodb-runner stop --id=docustamp-test",
    "watch": "nodemon index.js"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.1",
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@parse/fs-files-adapter": "^3.0.0",
    "@parse/push-adapter": "^8.5.0",
    "@parse/s3-files-adapter": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "coherentpdf": "^2.5.5",
    "cors": "^2.8.6",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "generate-api-key": "^1.0.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "libreoffice-convert": "^1.8.1",
    "mailgun.js": "^13.0.0",
    "moment": "^2.30.1",
    "mongodb": "^7.2.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "node-forge": "^1.3.3",
    "nodemailer": "^9.0.1",
    "p-limit": "^7.3.0",
    "parse": "^8.6.0",
    "parse-dbtool": "^1.2.0",
    "parse-server": "^8.6.84",
    "parse-server-api-mail-adapter": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "posthog-node": "^5.21.2",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.1.1",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "type": "module",
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^14.0.0",
    "jasmine": "^6.2.0",
    "mongodb-runner": "^6.7.8",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "brace-expansion": ">=2.1.2",
    "ws": "$ws",
    "parse": "$parse",
    "form-data": "$form-data",
    "@parse/push-adapter": "$@parse/push-adapter",
    "@grpc/grpc-js": ">=1.14.4",
    "fast-xml-builder": "1.2.0",
    "protobufjs": ">=7.6.3",
    "tmp": ">=0.2.7",
    "decompress": "npm:@xhmikosr/decompress@^11.1.4",
    "tar": "^7.5.19",
    "websocket-driver": ">=0.7.5",
    "js-yaml": "^3.15.0",
    "lodash": "^4.18.0",
    "undici": "^7.29.0",
    "uuid": ">=11.1.1",
    "body-parser": ">=2.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
