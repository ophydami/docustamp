# Copy to .env.local for local dev.
# Parse app id; must match APP_ID on the server.
VITE_APPID=docustamp
# Full Parse server URL. Leave unset to use same-origin /api/app
# (dev: proxied to VITE_DEV_PROXY_TARGET; prod: Caddy routes it).
# VITE_SERVERURL=https://sign.example.com/api/app
# Where the Vite dev proxy forwards /api/* (the Parse server's Express app).
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Optional Google client id for "Continue with Google".
VITE_GOOGLE_CLIENT_ID=
# The server's Parse mount (PARSE_MOUNT on the server, default /app). Only needed
# for a multi-segment mount: the app otherwise strips the last path segment of
# VITE_SERVERURL to reach the Express routes (/docxtopdf, /deleteuser, /mcp, /v1).
# VITE_PARSE_MOUNT=/app
# Those Express routes, when they are not simply VITE_SERVERURL minus the mount.
# VITE_CUSTOM_ROUTE_BASE=https://sign.example.com/api
# Where the "Source" links in the app point. The AGPL asks anyone who runs a
# modified copy for others to offer its source, so set this to your own repo.
# VITE_SOURCE_URL=https://github.com/you/your-fork
