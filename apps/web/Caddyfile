{
	auto_https off
}

:3000 {
	root * /srv
	encode zstd gzip

	# Hashed assets can be cached forever; index.html must not be.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Every non-asset path falls back to index.html (deep SPA links included), so
	# all of them must be revalidated or a deploy leaves returning tabs on old JS.
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# SPA fallback
	try_files {path} /index.html
	file_server
}
