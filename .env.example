# DocuStamp server settings.
#
# Copy this file to .env.prod (docker-compose.yml reads that name) and fill in the
# REQUIRED section. Everything else has a working default and can stay empty.
# Generate secrets with:  openssl rand -hex 32

# REQUIRED *******************************************************************************

# The public address people open in their browser, with no trailing slash, and
# where the API is reachable (that address followed by /api/app). With the bundled
# docker-compose.yml both are set from HOST_URL instead, and these are ignored.
PUBLIC_URL=https://sign.example.com
SERVER_URL=https://sign.example.com/api/app
# Long random secret with full access to all data. Never share it.
MASTER_KEY=
# MongoDB connection string. The bundled docker-compose database is at mongo:27017.
MONGODB_URI=mongodb://mongo:27017/docustamp

# Email: set either the SMTP block or the Mailgun block, or no email is sent
# (signing invitations, reminders and password resets all need it).
SMTP_ENABLE=true
SMTP_HOST=smtp.example.com
# 465 uses TLS from the start; any other port (587, 25) upgrades with STARTTLS.
SMTP_PORT=465
# The "from" address on every mail.
SMTP_USER_EMAIL=no-reply@example.com
# Login for the SMTP server. Defaults to SMTP_USER_EMAIL when empty.
SMTP_USERNAME=
SMTP_PASS=
# Mailgun instead of SMTP (leave SMTP_ENABLE empty to use it).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=

# BRANDING *******************************************************************************

# Name shown in emails, PDF signatures and the app when a workspace has no name.
APP_NAME=DocuStamp
# Public image url for the email header. Empty shows APP_NAME as a text wordmark.
APP_LOGO_URL=
# Header colour of the HTML emails.
APP_MAIL_COLOR=#0f6e56
# Address behind the "file a complaint" link in the email footer. Empty shows a
# plain "Sent via <APP_NAME>" line instead.
APP_COMPLAINTS_EMAIL=
# Contact written into PDF signatures and shown in some error messages.
APP_SUPPORT_EMAIL=

# FILE STORAGE ***************************************************************************

# true keeps uploaded documents on the server's disk (the docker volume). For
# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean
# Spaces) set USE_LOCAL=false and fill in the DO_* values below.
USE_LOCAL=true
DO_SPACE=
DO_ENDPOINT=
DO_BASEURL=
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=

# DOCUMENT SIGNING CERTIFICATE ***********************************************************

# Leave both empty and the server creates a self-signed certificate on first boot
# and keeps it in the database. Signed PDFs are tamper-evident either way; PDF
# readers only show a signature as trusted when it comes from a certificate
# authority, which you supply here as a base64-encoded .pfx/.p12 file.
PFX_BASE64=
PASS_PHRASE=

# AI DOCUMENT PREPARATION (optional) *****************************************************

# Off until a provider is configured. To use Claude through the Anthropic API, set:
ANTHROPIC_API_KEY=
# Or Amazon Bedrock: AI_PROVIDER=bedrock plus AWS credentials (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY or AWS_BEARER_TOKEN_BEDROCK) and AI_REGION.
AI_PROVIDER=
AI_MODEL=
AI_REGION=
# true or false forces AI on or off regardless of the above.
AI_ENABLED=

# SIGN-IN (optional) *********************************************************************

# OAuth client id for "Sign in with Google". Empty hides the button. The web app
# reads the same value at build time as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Base url of an external OAuth provider for the `sso` auth adapter. Only
# registered when set.
SSO_API_URL=

# AUTOMATIC REMINDERS ********************************************************************

# The hourly job that reminds signers on documents with automatic reminders on.
AUTO_REMINDERS=true
AUTO_REMINDERS_INTERVAL_MINUTES=60
AUTO_REMINDERS_MAX_DOCS=200

# SECRETS (optional; each falls back to a key derived from MASTER_KEY) *******************

# Signs the tokens in signing links.
SIGNING_LINK_SECRET=
# Signs the short-lived read tokens on /files/ urls. Set it: the fallback reuses
# MASTER_KEY, which also authorises everything else.
FILE_TOKEN_SECRET=
# Signs account-deletion links.
ACCOUNT_DELETION_SECRET=

# NETWORK AND HARDENING (optional) *******************************************************

# Number of reverse proxies in front of the server. The bundled Caddy is one.
# This decides which address is recorded as the client IP in audit trails.
TRUST_PROXY=1
# Addresses allowed to use the master key, e.g. 127.0.0.1,::1,172.16.0.0/12
MASTER_KEY_IPS=
# Extra browser origins allowed to call the API. PUBLIC_URL is always allowed.
CORS_ORIGINS=
# Internal url the server uses to call itself. Default http://localhost:8080/app.
INTERNAL_SERVER_URL=
# Must stay /app; kept for older env files.
PARSE_MOUNT=/app
# Internal Parse application id. Must match VITE_APPID in the web build.
APP_ID=opensign
# Request size caps (defaults: 72mb, 25mb, 256kb).
PARSE_BODY_LIMIT=
API_BODY_LIMIT=
CUSTOM_ROUTE_BODY_LIMIT=
# Requests per minute per IP on the plain Express routes.
CUSTOM_ROUTE_RATE_LIMIT=
DOCX2PDF_RATE_LIMIT=
DECRYPTPDF_RATE_LIMIT=
DELETE_OTP_RATE_LIMIT=
# parse-server's own limits; PARSE_RATE_LIMIT=off disables them.
PARSE_RATE_LIMIT=
RATE_LIMIT_LOGIN=
RATE_LIMIT_PASSWORD_RESET=
RATE_LIMIT_SIGNUP=
RATE_LIMIT_FUNCTIONS=
# Send webhooks to plain http:// urls (off by default).
ALLOW_HTTP_WEBHOOKS=
# Let url imports fetch private network addresses (off by default).
ALLOW_PRIVATE_FETCH=

# DOCX TO PDF CONVERSION (optional) ******************************************************

DOCX2PDF_CONCURRENCY=
DOCX2PDF_MAX_QUEUE=
DOCX2PDF_QUEUE_WAIT_MS=
DOCX2PDF_STUCK_AGE_SECONDS=

# MISC (optional) ************************************************************************

# How many rotated log files to keep ('5' files or '7d' days).
MAX_LOG_FILES=
# 'error' or 'silent' for failed cloud function logs.
PARSE_LOG_CLOUD_ERRORS=
# Milliseconds the SMTP check at boot may take (default 10000).
SMTP_VERIFY_TIMEOUT_MS=
# Milliseconds outside traffic waits for migrations at boot (default 120000).
MIGRATION_GATE_TIMEOUT_MS=
# Documents created before this ISO time may still open old-style signing links.
SIGNING_TOKEN_REQUIRED_FROM=
# Mongo instance the test suite uses (everything in it is deleted).
MONGODB_TEST_URI=
